{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hirachan/kfd/schema/knowledge.schema.json",
  "title": "KFD knowledge unit",
  "description": "A unit's purpose, contract, examples, dependencies, and implementation ownership.",
  "type": "object",
  "required": ["id", "name", "purpose", "contract"],
  "additionalProperties": false,
  "properties": {
    "id": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 1},
    "purpose": {
      "type": "object",
      "required": ["why"],
      "properties": {"why": {"type": "string", "minLength": 1}},
      "additionalProperties": true
    },
    "contract": {
      "type": "object",
      "required": ["rules"],
      "properties": {
        "rules": {
          "if": {"type": "array"},
          "then": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
          "else": {
            "type": "object",
            "propertyNames": {"pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"},
            "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
          }
        }
      },
      "additionalProperties": true
    },
    "examples": {"type": "array", "items": {"type": "object"}},
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reads": {"$ref": "#/$defs/dependencies"},
        "writes": {"$ref": "#/$defs/dependencies"}
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primary": {"$ref": "#/$defs/paths"},
            "shared": {"$ref": "#/$defs/paths"}
          }
        },
        "tests": {"$ref": "#/$defs/paths"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "rule": {
      "type": "object",
      "required": ["id", "rule"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "rule": {"type": "string", "minLength": 1},
        "applies_when": {"type": "string", "minLength": 1},
        "uses": {"type": "array", "items": {"$ref": "#/$defs/ruleRef"}},
        "status": {"enum": ["active", "retired"]},
        "superseded_by": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ruleRef"}}
      },
      "if": {"required": ["superseded_by"]},
      "then": {"required": ["status"], "properties": {"status": {"const": "retired"}}},
      "additionalProperties": true
    },
    "ruleRef": {"type": "string", "pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*/)?[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "dependencies": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    }
  }
}
