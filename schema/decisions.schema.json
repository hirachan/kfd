{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hirachan/kfd/schema/decisions.schema.json",
  "title": "KFD unit decisions",
  "description": "Recorded decisions and their local or fully qualified affected rules.",
  "type": "object",
  "required": ["decisions"],
  "additionalProperties": false,
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "date", "status", "decision"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "status": {"type": "string"},
          "decision": {"type": "string"},
          "context": {"type": "string"},
          "reason": {"type": "string"},
          "rejected": {"type": "array", "items": {}},
          "affects_rules": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)?$"}
          }
        }
      }
    }
  }
}
